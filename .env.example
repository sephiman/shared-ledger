# Externally-managed Postgres on a shared Docker network.
# The backend joins this network and resolves Postgres by DNS alias = DB_HOST.
SHARED_NETWORK_NAME=all_dockers

# Host port published for the frontend (Nginx Proxy Manager / external nginx terminates TLS in front of this).
FRONTEND_PORT=8087

# Host interface to bind the published port on.
#   0.0.0.0  -> reachable from anywhere the host's port is reachable (use when NPM is on this host
#               but outside Docker, or on another machine that can reach this host's IP)
#   127.0.0.1 -> reachable only from the host loopback (use when NPM is on the same host AND only
#               needs to hit localhost, or when you'll instead reach the frontend over the Docker
#               shared network — see below)
FRONTEND_BIND_ADDR=0.0.0.0

# Database — the operator must create this DB and user in Postgres before first run.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sharedledger
DB_USERNAME=sharedledger
DB_PASSWORD=change-me

# Cookie security. Set to false ONLY for local plain-HTTP development.
APP_COOKIE_SECURE=true

# Registration policy: open | invite-only | closed
REGISTRATION_MODE=open

# First-run admin bootstrap. Required if no users exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# Bootstrap household.
BOOTSTRAP_HOUSEHOLD_NAME=Home
BOOTSTRAP_HOUSEHOLD_CURRENCY=EUR
BOOTSTRAP_HOUSEHOLD_LOCALE=en

# Telegram notifications (optional). Each household configures its own bot/chat in
# Settings; these are app-wide knobs only.
#   TELEGRAM_TOKEN_KEY: base64-encoded AES key (16/24/32 bytes) used to encrypt stored
#     bot tokens at rest. Generate one with:  openssl rand -base64 32
#     Required only if a household actually saves a bot token. Keep it stable — rotating
#     it makes previously stored tokens undecryptable.
TELEGRAM_TOKEN_KEY=
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_TIMEOUT_MS=5000

# Portfolio price providers (optional — holdings work without them, but stay unpriced).
#   Equities default to Yahoo Finance (unofficial): no key, no hard quota, long history,
#   covers European UCITS ETFs in EUR. ToS-gray and can break without notice; switch
#   EQUITY_PRICE_PROVIDER to eodhd (EODHD_API_KEY, 20 calls/day, 1y history) or
#   twelve_data (TWELVEDATA_API_KEY, no UCITS ETFs on free plan) for an official source.
#   COINGECKO_API_KEY: CoinGecko Demo plan key (https://www.coingecko.com/en/api) for crypto prices.
#   FX rates come from Frankfurter (ECB) and need no key.
COINGECKO_API_KEY=
# EQUITY_PRICE_PROVIDER=yahoo
# EODHD_API_KEY=
# TWELVEDATA_API_KEY=
# COINGECKO_API_BASE_URL=https://api.coingecko.com
# BINANCE_API_BASE_URL=https://api.binance.com
# YAHOO_API_BASE_URL=https://query1.finance.yahoo.com
# EODHD_API_BASE_URL=https://eodhd.com
# FRANKFURTER_API_BASE_URL=https://api.frankfurter.dev

# JVM tuning (optional).
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=
